{
  "name": "official-letter-editor",
  "version": "0.2.0",
  "description": "公文 Editor — web 版（Express + SQLite，瀏覽器前端）",
  "main": "backend/server.js",
  "scripts": {
    "build:css": "tailwindcss -c frontend/tailwind.config.js -i frontend/src/input.css -o frontend/public/app.css --minify",
    "watch:css": "tailwindcss -c frontend/tailwind.config.js -i frontend/src/input.css -o frontend/public/app.css --watch",
    "prestart": "npm run build:css",
    "start": "node backend/server.js",
    "predev": "npm run build:css",
    "dev": "concurrently -k -n css,server -c cyan,green \"npm:watch:css\" \"npm:dev:server\"",
    "dev:server": "LIVERELOAD=1 nodemon --quiet --watch backend --ext js backend/server.js"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "docx-preview": "^0.3.2",
    "express": "^4.22.2",
    "iconv-lite": "^0.7.2",
    "jszip": "^3.10.1",
    "quill": "^2.0.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "connect-livereload": "^0.6.1",
    "livereload": "^0.10.3",
    "nodemon": "^3.1.14",
    "tailwindcss": "^3.4.19"
  }
}
